modules = ["python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["cairo", "espeak-ng", "ffmpeg-full", "freetype", "ghostscript", "gobject-introspection", "gtk3", "libGL", "libGLU", "libxcrypt", "libyaml", "pkg-config", "portaudio", "qhull", "tcl", "tk"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Voice Assistant API"

[[workflows.workflow]]
name = "Voice Assistant API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py --api-only"
waitForPort = 5000
