# Voice Assistant Configuration
# Copy this file to .env and update the values

# ============================================================================
# CORE SETTINGS
# ============================================================================

# Wake word for voice activation (default: assistant)
WAKE_WORD=assistant

# Wake word detection sensitivity (0.1 - 1.0, default: 0.5)
SENSITIVITY=0.5

# Language for speech recognition (default: en-US)
LANGUAGE=en-US

# Timezone (default: UTC)
TIMEZONE=UTC

# ============================================================================
# VOICE & AUDIO SETTINGS
# ============================================================================

# Voice name (leave empty for system default)
VOICE_NAME=

# Speech rate in words per minute (default: 200)
VOICE_RATE=200

# Voice pitch (Linux only, 0-100, default: 50)
VOICE_PITCH=50

# Voice volume (0.0-1.0, default: 0.8)
VOICE_VOLUME=0.8

# Microphone device index (leave empty for default)
MICROPHONE_INDEX=

# Speaker device index (leave empty for default)
SPEAKER_INDEX=

# Audio sample rate (default: 16000)
SAMPLE_RATE=16000

# Audio chunk size (default: 1024)
CHUNK_SIZE=1024

# ============================================================================
# LISTENER SETTINGS
# ============================================================================

# Timeout after wake word detection in seconds (default: 5.0)
LISTENER_TIMEOUT=5.0

# Maximum phrase duration in seconds (default: 10.0)
LISTENER_PHRASE_LIMIT=10.0

# Speech synthesis timeout in seconds (default: 15.0)
SPEECH_TIMEOUT=15.0

# ============================================================================
# API SERVER SETTINGS
# ============================================================================

# Enable API server (default: true)
ENABLE_API=true

# API server host (default: 0.0.0.0)
API_HOST=0.0.0.0

# API server port (default: 8000)
API_PORT=8000

# API authentication token (CHANGE THIS!)
API_TOKEN=default_token_change_me

# CORS allowed origins (comma-separated, default: *)
CORS_ORIGINS=*

# ============================================================================
# WEB UI SETTINGS
# ============================================================================

# Enable web UI (default: true)
ENABLE_WEB_UI=true

# Web UI port (default: 5000)
WEB_UI_PORT=5000

# ============================================================================
# OPENAI SETTINGS
# ============================================================================

# OpenAI API key for AI features (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Maximum tokens for OpenAI responses (default: 500)
OPENAI_MAX_TOKENS=500

# ============================================================================
# GOOGLE SERVICES
# ============================================================================

# Path to Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=

# Gmail user email address
GMAIL_USER=

# ============================================================================
# WEATHER SETTINGS
# ============================================================================

# OpenWeatherMap API key (get from https://openweathermap.org/api)
WEATHER_API_KEY=

# Default location for weather (default: New York, NY)
DEFAULT_LOCATION=New York, NY

# ============================================================================
# STOCK SETTINGS
# ============================================================================

# Stock API key (currently using Yahoo Finance - no key needed)
STOCK_API_KEY=

# Default stock symbols to monitor (comma-separated)
DEFAULT_STOCKS=AAPL,GOOGL,MSFT,TSLA

# ============================================================================
# NEWS SETTINGS
# ============================================================================

# News API key (get from https://newsapi.org/register)
NEWS_API_KEY=

# Default news sources (comma-separated)
NEWS_SOURCES=bbc-news,cnn,reuters,associated-press

# ============================================================================
# TELEGRAM SETTINGS
# ============================================================================

# Telegram bot token (create bot with @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID for notifications
TELEGRAM_CHAT_ID=

# ============================================================================
# SMART HOME SETTINGS
# ============================================================================

# Enable smart home features (default: false)
ENABLE_SMART_HOME=false

# MagicHome device IP addresses (comma-separated)
MAGIC_HOME_DEVICES=

# LG WebOS TV IP address
LG_TV_IP=

# Roku device IP address
ROKU_IP=

# ============================================================================
# CAMERA SETTINGS
# ============================================================================

# Enable face recognition (default: false)
ENABLE_FACE_RECOGNITION=false

# Camera device index (default: 0)
CAMERA_INDEX=0

# Face recognition tolerance (0.0-1.0, default: 0.6)
FACE_RECOGNITION_TOLERANCE=0.6

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Encryption key for sensitive data (CHANGE THIS!)
ENCRYPTION_KEY=default_key_change_me

# JWT secret for token generation (CHANGE THIS!)
JWT_SECRET=default_jwt_secret_change_me

# JWT token expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24

# ============================================================================
# LOGGING SETTINGS
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path (default: assistant.log)
LOG_FILE=data/logs/assistant.log

# Maximum log file size in bytes (default: 10MB)
MAX_LOG_SIZE=10485760

# Number of backup log files to keep (default: 5)
LOG_BACKUP_COUNT=5

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Maximum worker threads (default: 4)
MAX_WORKERS=4

# Request timeout in seconds (default: 30.0)
REQUEST_TIMEOUT=30.0

# Enable caching (default: true)
ENABLE_CACHING=true

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Debug mode (default: false)
DEBUG_MODE=false

# Enable profiling (default: false)
ENABLE_PROFILING=false

# Root password for Linux system commands (optional)
ROOT_PASSWORD=

# ============================================================================
# ADDITIONAL INTEGRATIONS
# ============================================================================

# GitHub personal access token (for GitHub integration)
GITHUB_TOKEN=

# Spotify client ID and secret (for music control)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Custom API endpoints
CUSTOM_API_ENDPOINT=

# Additional device IPs or hostnames
ADDITIONAL_DEVICES=

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. API Keys:
#    - Most features require API keys from respective services
#    - Get OpenAI key from: https://platform.openai.com/api-keys
#    - Get Weather key from: https://openweathermap.org/api
#    - Get News key from: https://newsapi.org/register
#
# 2. Security:
#    - Always change default tokens and secrets in production
#    - Use strong, unique passwords and tokens
#    - Consider using environment variable injection for sensitive data
#
# 3. Smart Home:
#    - Device discovery can help find IP addresses
#    - Test device connectivity before adding to configuration
#    - Some devices may require additional setup
#
# 4. Permissions:
#    - Ensure microphone and camera permissions are granted
#    - Some system control features require elevated permissions
#    - Check firewall settings for network features
#
# 5. Performance:
#    - Adjust worker threads based on your system capabilities
#    - Enable caching for better performance
#    - Monitor resource usage and adjust settings accordingly
#
# ============================================================================
